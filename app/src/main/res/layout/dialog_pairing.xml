<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@color/color_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="8dp"
    android:layout_margin="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/dialog_pairing_title"
            android:textColor="@color/primary_light"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="1. اضغط على الزر لفتح خيارات المطور في شاشة منقسمة.\n2. اضغط (اقتران الجهاز برمز الاقتران).\n3. سيتم اكتشاف المنفذ تلقائياً، اكتب فقط الرمز (6 أرقام)."
            android:textColor="@color/color_text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <!-- Auto Discovery Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardDiscoveryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:cardBackgroundColor="#1A6366F1"
            app:cardCornerRadius="8dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="10dp"
                android:gravity="center_vertical">

                <ProgressBar
                    android:id="@+id/pbDiscovery"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/tvDiscoveryStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔍 جاري البحث عن المنفذ تلقائياً..."
                    android:textColor="@color/primary_light"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Open Developer Options in Split Screen -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenDevSettings"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="@color/primary"
            android:text="📱 فتح خيارات المطور (شاشة منقسمة)"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            app:cornerRadius="10dp" />

        <!-- Pairing Code Input (Prominent & Focused) -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPairingCode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="أدخل رمز الاقتران (6 أرقام)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="@color/primary"
            app:hintTextColor="@color/primary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPairingCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="@color/color_text_primary"
                android:textStyle="bold"
                android:textSize="20sp"
                android:textAlignment="center"
                android:gravity="center"
                android:letterSpacing="0.2"
                android:maxLength="6"
                android:maxLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Toggle Manual Ports Link -->
        <TextView
            android:id="@+id/tvToggleManualPorts"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp"
            android:padding="6dp"
            android:text="إظهار / تعديل المنافذ يدوياً ▼"
            android:textColor="@color/primary_light"
            android:textSize="11sp" />

        <!-- Hidden Manual Ports Section -->
        <LinearLayout
            android:id="@+id/layoutManualPorts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Pairing Port Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPairingPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/hint_pairing_port"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="@color/primary"
                app:hintTextColor="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPairingPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/color_text_primary"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Connection Port Input -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConnectPort"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/hint_connect_port"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                app:boxStrokeColor="@color/primary"
                app:hintTextColor="@color/primary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConnectPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:textColor="@color/color_text_primary"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelPairing"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="@string/dialog_cancel"
                android:textColor="@color/color_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirmPairing"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/primary_dark"
                android:text="@string/dialog_confirm_pair"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
